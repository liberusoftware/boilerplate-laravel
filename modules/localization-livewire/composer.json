{
  "name": "liberusoftware/localization-livewire",
  "description": "Livewire locale-switching presentation adapter for Liberu Localization.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "livewire/livewire": "^4.0",
    "liberusoftware/localization": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\LocalizationLivewire\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "localization-livewire"
    }
  },
  "version": "1.0.3",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\LocalizationLivewire\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.1",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
