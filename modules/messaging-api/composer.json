{
  "name": "liberusoftware/messaging-api",
  "description": "Authenticated API presentation adapter for Liberu Messaging.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "liberusoftware/messaging": "^1.0"
  },
  "require-dev": {
    "orchestra/testbench": "^11.1",
    "pestphp/pest": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Messaging\\Api\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Messaging\\Api\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "liberu": {
      "name": "messaging-api"
    }
  },
  "version": "1.0.3"
}
