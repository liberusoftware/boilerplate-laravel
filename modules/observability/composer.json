{
  "name": "liberusoftware/observability",
  "description": "Structured diagnostics, monitoring dashboards, health signals, and redaction defaults.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "laravel/horizon": "^5.50.1",
    "laravel/pulse": "^1.8.1",
    "laravel/telescope": "^5.26.0",
    "liberusoftware/module-manager": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\Observability\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "observability"
    }
  },
  "version": "1.4.1",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\Observability\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.5",
    "pestphp/pest": "^5.3.3"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
