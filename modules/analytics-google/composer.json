{
  "name": "liberusoftware/analytics-google",
  "description": "Consent-aware Google Analytics event mapping adapter.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/support": "^13.0",
    "liberusoftware/analytics-contracts": "^1.0",
    "liberusoftware/integrations": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\Analytics\\Google\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "analytics-google"
    }
  },
  "version": "1.0.4",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\Analytics\\Google\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.1",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
