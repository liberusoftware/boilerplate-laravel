{
  "name": "liberusoftware/search-demo",
  "description": "Reference searchable post and group records for the boilerplate integration test bed.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0",
    "liberusoftware/module-manager": "^1.0",
    "liberusoftware/search": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Search\\Demo\\": "src/",
      "Liberu\\Search\\Demo\\Database\\Factories\\": "database/factories/"
    }
  },
  "extra": {
    "liberu": {
      "name": "search-demo"
    }
  },
  "version": "1.0.4",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Search\\Demo\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.1",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
