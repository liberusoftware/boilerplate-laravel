{
  "name": "liberusoftware/roles-permissions-filament",
  "description": "Filament Shield presentation adapter for Liberu authorization.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "bezhansalleh/filament-shield": "^4.3.1",
    "filament/filament": "^5.11.0",
    "liberusoftware/roles-permissions": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\RolesPermissionsFilament\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "roles-permissions-filament"
    }
  },
  "version": "1.4.1",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\RolesPermissionsFilament\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.5",
    "pestphp/pest": "^5.3.3"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
