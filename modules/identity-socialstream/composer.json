{
  "name": "liberusoftware/identity-socialstream",
  "description": "Socialstream/Socialite identity-linking provider adapter.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "bursteri/socialstream": "^7.0",
    "laravel/socialite": "^5.0",
    "liberusoftware/identity-core": "^1.0",
    "liberusoftware/module-manager": "^1.0",
    "liberusoftware/organizations-teams": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\Identity\\Socialstream\\": "src/",
      "Liberu\\Foundation\\Identity\\Socialstream\\Database\\Factories\\": "database/factories/"
    }
  },
  "extra": {
    "liberu": {
      "name": "identity-socialstream"
    }
  },
  "version": "1.1.0",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\Identity\\Socialstream\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.1",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
