{
  "name": "liberusoftware/profiles",
  "description": "Controlled profile updates and user presentation preferences.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0",
    "liberusoftware/identity-core": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\Profiles\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "profiles"
    }
  },
  "version": "1.4.1",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\Profiles\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.5",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
