{
  "name": "liberusoftware/analytics-meta",
  "description": "Consent-aware Meta server-side event mapping and normalized customer-data adapter.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/support": "^13.0",
    "liberusoftware/analytics-contracts": "^1.0",
    "liberusoftware/integrations": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\Analytics\\Meta\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "analytics-meta"
    }
  },
  "version": "1.0.3",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\Analytics\\Meta\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.1",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
