{
    "$schema": "https://schemas.liberu.dev/module/v1.json",
    "name": "foundation-filament",
    "display_name": "Foundation Filament",
    "description": "Accessible account security/preferences and authorized foundation operations diagnostics.",
    "version": "1.0.4",
    "category": "presentation",
    "provider": "Liberu\\Foundation\\Filament\\FoundationFilamentServiceProvider",
    "requires": {
        "php": "^8.5",
        "laravel": "^13.0",
        "packages": {
            "liberusoftware/module-manager": "^1.0",
            "liberusoftware/theme-support": "^1.0",
            "liberusoftware/sessions-devices": "^1.0",
            "liberusoftware/observability": "^1.0"
        }
    },
    "suggests": [],
    "presentation": {
        "filament": {
            "admin": [
                "Liberu\\Foundation\\Filament\\FoundationAdminPlugin"
            ],
            "app": [
                "Liberu\\Foundation\\Filament\\FoundationAccountPlugin"
            ]
        }
    },
    "capabilities": [
        "foundation.filament"
    ],
    "default_enabled": true,
    "features": [
        "Accessible account security/preferences and authorized foundation operations diagnostics"
    ]
}
