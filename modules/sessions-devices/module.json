{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "sessions-devices",
  "display_name": "Sessions and Devices",
  "description": "Privacy-conscious active-session inventory, current-session protection, and revocation.",
  "version": "1.4.1",
  "category": "foundation",
  "provider": "Liberu\\Foundation\\Sessions\\SessionsDevicesServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/identity-core": "^1.0"
    }
  },
  "suggests": {
    "liberusoftware/audit": "^1.0"
  },
  "capabilities": [
    "identity.sessions"
  ],
  "default_enabled": true,
  "features": [
    "Privacy-conscious active-session inventory",
    "Current-session protection",
    "Revocation"
  ]
}
