{
  "name": "liberusoftware/localization-core-livewire",
  "description": "Livewire locale-switching presentation adapter for Liberu Localization.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "livewire/livewire": "^4.0",
    "liberusoftware/localization-core": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\LocalizationLivewire\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "localization-core-livewire"
    }
  },
  "version": "1.4.1",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\LocalizationLivewire\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/profiles": "^1.0",
    "liberusoftware/package-testbench": "^1.7",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
