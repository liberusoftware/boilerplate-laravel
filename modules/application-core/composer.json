{
  "name": "liberusoftware/application-core",
  "description": "Required application metadata, health, clocks, identifiers, and secure HTTP defaults.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/http": "^13.0",
    "illuminate/support": "^13.0",
    "liberusoftware/module-manager": "^1.0"
  },
  "require-dev": {
    "orchestra/testbench": "^11.1",
    "pestphp/pest": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\ApplicationCore\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\ApplicationCore\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "liberu": {
      "name": "application-core"
    }
  },
  "version": "1.0.3"
}
