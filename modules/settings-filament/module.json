{
    "$schema": "https://schemas.liberu.dev/module/v1.json",
    "name": "settings-filament",
    "display_name": "Settings Administration",
    "description": "Optional Filament settings administration surface.",
    "version": "1.4.1",
    "category": "presentation",
    "provider": "Liberu\\Foundation\\SettingsFilament\\SettingsFilamentServiceProvider",
    "requires": {
        "php": "^8.5",
        "laravel": "^13.0",
        "packages": {
            "liberusoftware/settings": "^1.0",
            "liberusoftware/theme-support": "^1.0"
        }
    },
    "suggests": [],
    "presentation": {
        "filament": {
            "admin": [
                "Liberu\\Foundation\\SettingsFilament\\SettingsFilamentPlugin"
            ]
        }
    },
    "capabilities": [
        "foundation.settings.filament"
    ],
    "default_enabled": true,
    "features": [
        "Optional Filament settings administration surface"
    ]
}
