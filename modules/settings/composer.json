{
  "name": "liberusoftware/settings",
  "description": "Typed scoped settings foundation for Liberu applications.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "spatie/laravel-settings": "^3.0",
    "liberusoftware/module-manager": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\Settings\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "settings"
    }
  },
  "version": "1.4.0",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\Settings\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.7",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
