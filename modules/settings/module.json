    "requires": { "php": "^8.5", "laravel": "^13.0", "packages": { "liberusoftware/module-manager": "^1.0" } },
    "suggests": { "liberusoftware/settings-filament": "^1.0" },
    "capabilities": ["foundation.settings"],
