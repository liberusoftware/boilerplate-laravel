{
  "name": "liberusoftware/jetstream-bridge",
  "description": "Fortify and Jetstream-compatible action adapters for Liberu identity capabilities.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "laravel/fortify": "^1.0",
    "laravel/jetstream": "^5.1",
    "liberusoftware/identity-core": "^1.0",
    "liberusoftware/module-manager": "^1.0",
    "liberusoftware/organizations-teams": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\JetstreamBridge\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "jetstream-bridge"
    }
  },
  "version": "1.4.1",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\JetstreamBridge\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.5",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
