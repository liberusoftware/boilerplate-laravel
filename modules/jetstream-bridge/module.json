{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "jetstream-bridge",
  "display_name": "Jetstream Bridge",
  "description": "Fortify and Jetstream-compatible registration, profile, password, team, and account-deletion actions.",
  "version": "1.4.1",
  "category": "foundation",
  "provider": "Liberu\\Foundation\\JetstreamBridge\\Providers\\FortifyServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/identity-core": "^1.0",
      "liberusoftware/module-manager": "^1.0",
      "liberusoftware/organizations-teams": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.jetstream-bridge"
  ],
  "default_enabled": true,
  "features": [
    "Fortify and Jetstream-compatible registration",
    "Profile",
    "Password",
    "Team",
    "Account-deletion actions"
  ]
}
