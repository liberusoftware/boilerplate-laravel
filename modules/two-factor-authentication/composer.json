{
  "name": "liberusoftware/two-factor-authentication",
  "description": "TOTP enforcement policy and one-time recovery-code primitives.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/contracts": "^13.0",
    "illuminate/support": "^13.0",
    "liberusoftware/identity-core": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\TwoFactor\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "two-factor-authentication"
    }
  },
  "version": "1.4.1",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\TwoFactor\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.5",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
