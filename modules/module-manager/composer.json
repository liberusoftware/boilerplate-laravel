{
  "name": "liberusoftware/module-manager",
  "description": "Deterministic manifest discovery and runtime enablement for Liberu modules.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "composer/semver": "^3.4",
    "illuminate/contracts": "^13.0",
    "illuminate/support": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\ModuleManager\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "module-manager"
    }
  },
  "version": "1.4.0",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\ModuleManager\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.5",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
