{
  "name": "liberusoftware/localization-mymemory",
  "description": "MyMemory machine-translation adapter for Liberu Localization.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/http": "^13.0",
    "illuminate/cache": "^13.0",
    "liberusoftware/localization-contracts": "^1.0"
  },
  "require-dev": {
    "orchestra/testbench": "^11.1",
    "pestphp/pest": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\Localization\\MyMemory\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\Localization\\MyMemory\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "liberu": {
      "name": "localization-mymemory"
    }
  },
  "version": "1.0.3"
}
