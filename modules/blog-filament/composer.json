{
  "name": "liberusoftware/blog-filament",
  "description": "Filament administration adapter for Liberu Blog.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "filament/filament": "^5.1",
    "liberusoftware/blog-core": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Blog\\Filament\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "blog-filament"
    }
  },
  "version": "1.0.4",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Blog\\Filament\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.1",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
