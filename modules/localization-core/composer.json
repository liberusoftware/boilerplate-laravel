{
  "name": "liberusoftware/localization-core",
  "description": "Locale resolution, preferences, propagation, and UI direction for Liberu applications.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/contracts": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/support": "^13.0",
    "liberusoftware/localization-contracts": "^1.0",
    "liberusoftware/module-manager": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\Localization\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "localization-core"
    }
  },
  "version": "1.4.1",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\Localization\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/profiles": "^1.0",
    "liberusoftware/package-testbench": "^1.7",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
