{
  "name": "liberusoftware/search-api",
  "description": "HTTP API presentation adapter for Liberu Search.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "liberusoftware/search": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\SearchApi\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "search-api"
    }
  },
  "version": "1.0.3",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\SearchApi\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.1",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
