{
  "name": "liberusoftware/theme-base",
  "description": "Shared semantic tokens and accessible presentation primitives for Liberu themes.",
  "type": "liberu-theme",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "liberusoftware/theme-support": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Themes\\Base\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "liberu-base"
    }
  },
  "version": "1.0.4",
  "require-dev": {
    "orchestra/testbench": "^11.1",
    "pestphp/pest": "^5.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Themes\\Base\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
