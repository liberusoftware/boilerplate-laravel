{
  "name": "liberusoftware/theme-default",
  "description": "Liberu default public theme.",
  "type": "liberu-theme",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "liberusoftware/theme-support": "^1.0",
    "liberusoftware/theme-base": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Themes\\DefaultTheme\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "default"
    }
  },
  "version": "1.5.1",
  "require-dev": {
    "liberusoftware/package-testbench": "^1.5",
    "pestphp/pest": "^5.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Themes\\DefaultTheme\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
