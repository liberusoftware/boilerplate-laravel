{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "liberusoftware/boilerplate-laravel",
    "type": "project",
    "description": "Liberu boilerplate Laravel application.",
    "keywords": [
        "laravel",
        "framework",
        "boilerplate"
    ],
    "license": "MIT",
    "repositories": [
        { "type": "path", "url": "packages/composer-installer", "options": { "symlink": false } },
        { "type": "path", "url": "packages/analytics-contracts", "options": { "symlink": false } },
        { "type": "path", "url": "packages/localization-contracts", "options": { "symlink": false } },
        { "type": "path", "url": "modules/*", "options": { "symlink": true } },
        { "type": "path", "url": "themes/*", "options": { "symlink": true } }
    ],
    "require": {
        "php": "^8.5",
        "bezhansalleh/filament-shield": "~4.0",
        "bursteri/socialstream": "^7.0",
        "filament/filament": "~5.1",
        "filament/spatie-laravel-settings-plugin": "^5.0",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.0",
        "laravel/jetstream": "^5.1",
        "laravel/octane": "^2.3",
        "laravel/pulse": "^1.7",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.0",
        "liberu/composer-installer": "^1.0",
        "liberu/analytics-contracts": "^1.0",
        "liberu/localization-contracts": "^1.0",
        "liberu/activity-comments": "^1.0",
        "liberu/analytics-core": "^1.0",
        "liberu/analytics-google": "^1.0",
        "liberu/analytics-meta": "^1.0",
        "liberu/api-access": "^1.0",
        "liberu/application-core": "^1.0",
        "liberu/audit": "^1.0",
        "liberu/blog-core": "^1.0",
        "liberu/blog-filament": "^1.0",
        "liberu/currency-context": "^1.0",
        "liberu/developer-experience": "^1.0",
        "liberu/feature-flags": "^1.0",
        "liberu/files-media": "^1.0",
        "liberu/foundation-filament": "^1.0",
        "liberu/identity": "^1.0",
        "liberu/identity-filament": "^1.0",
        "liberu/identity-socialstream": "^1.0",
        "liberu/import-export": "^1.0",
        "liberu/integrations": "^1.0",
        "liberu/jetstream-bridge": "^1.0",
        "liberu/localization": "^1.0",
        "liberu/localization-livewire": "^1.0",
        "liberu/localization-mymemory": "^1.0",
        "liberu/messaging": "^1.0",
        "liberu/messaging-api": "^1.0",
        "liberu/messaging-filament": "^1.0",
        "liberu/module-manager": "^1.0",
        "liberu/notifications": "^1.0",
        "liberu/observability": "^1.0",
        "liberu/organizations-teams": "^1.0",
        "liberu/organizations-teams-filament": "^1.0",
        "liberu/profiles": "^1.0",
        "liberu/roles-permissions": "^1.0",
        "liberu/roles-permissions-filament": "^1.0",
        "liberu/scheduler-queues": "^1.0",
        "liberu/search": "^1.0",
        "liberu/search-api": "^1.0",
        "liberu/search-demo": "^1.0",
        "liberu/sessions-devices": "^1.0",
        "liberu/settings": "^1.0",
        "liberu/settings-filament": "^1.0",
        "liberu/theme-support": "^1.0",
        "liberu/two-factor-authentication": "^1.0",
        "liberu/webhooks": "^1.0",
        "liberu/theme-base": "^1.0",
        "liberu/theme-clear-signal": "^1.0",
        "liberu/theme-dark": "^1.0",
        "liberu/theme-default": "^1.0",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-passkeys": "^1.6",
        "spatie/laravel-permission": "^7.0",
        "spiral/roadrunner-cli": "^2.6.0",
        "spiral/roadrunner-http": "^3.3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "filament/upgrade": "~5.1",
        "fruitcake/laravel-debugbar": "^4.3",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "laravel/sail": "^1.28",
        "laravel/telescope": "^5.20",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "pestphp/pest": "5.x-dev",
        "pestphp/pest-plugin-laravel": "5.x-dev",
        "phpunit/phpunit": "^13.1.8",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": "vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "platform-check": false,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "liberu/composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
