#!/usr/bin/env bash

set -euo pipefail

organisation="liberusoftware"
mode="dry-run"
visibility="public"
branch="main"

usage() {
    cat <<'EOF'
Usage: scripts/publish-components [--create] [--push] [--private] [--org ORGANISATION] [--branch BRANCH]

Without --create or --push the command prints the repositories it would publish.
--create creates missing repositories with gh. --push also creates missing repositories
and publishes every module, theme, and this meta repository.
EOF
}

while (($#)); do
    case "$1" in
        --create) mode="create" ;;
        --push) mode="push" ;;
        --private) visibility="private" ;;
        --org) shift; organisation="${1:?--org requires a value}" ;;
        --branch) shift; branch="${1:?--branch requires a value}" ;;
        --help|-h) usage; exit 0 ;;
        *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

command -v gh >/dev/null || { printf 'gh is required.\n' >&2; exit 1; }
command -v git >/dev/null || { printf 'git is required.\n' >&2; exit 1; }

root="$(git rev-parse --show-toplevel)"
cd "$root"

if [[ "$mode" == "push" ]] && [[ -n "$(git status --porcelain)" ]]; then
    printf 'Refusing to publish a dirty worktree. Commit all intended changes first.\n' >&2
    exit 1
fi

gh auth status --hostname github.com >/dev/null

declare -a paths=()
while IFS= read -r path; do
    paths+=("$path")
done < <(find modules themes -mindepth 1 -maxdepth 1 -type d -print | LC_ALL=C sort)

repository_for() {
    local path="$1"
    case "$path" in
        modules/*) printf 'module-%s' "${path#modules/}" ;;
        themes/*) printf 'theme-%s' "${path#themes/}" ;;
        *) return 1 ;;
    esac
}

ensure_repository() {
    local repository="$1"
    local description="$2"
    if gh repo view "$organisation/$repository" >/dev/null 2>&1; then
        return
    fi
    printf 'Creating %s/%s\n' "$organisation" "$repository"
    gh repo create "$organisation/$repository" "--$visibility" --description "$description" --disable-wiki
}

for path in "${paths[@]}"; do
    repository="$(repository_for "$path")"
    printf '%-42s <- %s\n' "$organisation/$repository" "$path"

    if [[ "$mode" != "dry-run" ]]; then
        ensure_repository "$repository" "Liberu ${repository#*-} ${repository%%-*} package"
    fi

    if [[ "$mode" == "push" ]]; then
        split_branch="publish/${repository}-$$"
        git branch -D "$split_branch" >/dev/null 2>&1 || true
        git subtree split --prefix="$path" -b "$split_branch"
        remote_url="git@github.com:$organisation/$repository.git"
        if git fetch "$remote_url" "$branch"; then
            git switch "$split_branch"
            git merge --allow-unrelated-histories --strategy=ours --no-edit FETCH_HEAD
            git switch -
        fi
        git push "$remote_url" "$split_branch:$branch"
        git branch -D "$split_branch"
    fi
done

printf '%-42s <- %s\n' "$organisation/boilerplate-laravel" '.'
if [[ "$mode" != "dry-run" ]]; then
    ensure_repository "boilerplate-laravel" 'Modular Laravel application foundation and reference implementation'
fi
if [[ "$mode" == "push" ]]; then
    git push "git@github.com:$organisation/boilerplate-laravel.git" "HEAD:$branch"
fi
