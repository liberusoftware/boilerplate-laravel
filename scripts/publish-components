#!/usr/bin/env bash
set -euo pipefail

mode="dry-run"
visibility="public"
branch="main"
only="all"
config="${META_CONFIG:-.liberu-meta.json}"

usage() {
    cat <<'EOF'
Usage: publish-components [--create|--push] [--private] [--config FILE]
                          [--org OWNER] [--branch BRANCH] [--only KIND]

KIND is all, modules, themes, scripts, or meta. Repository names and component
paths come from .liberu-meta.json. With no mutation flag, this is a dry run.
EOF
}

while (($#)); do
    case "$1" in
        --create) mode="create" ;;
        --push) mode="push" ;;
        --private) visibility="private" ;;
        --config) shift; config="${1:?--config requires a value}" ;;
        --org) shift; META_ORGANIZATION="${1:?--org requires a value}" ;;
        --branch) shift; branch="${1:?--branch requires a value}" ;;
        --only) shift; only="${1:?--only requires a value}" ;;
        --help|-h) usage; exit 0 ;;
        *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

[[ "$only" =~ ^(all|modules|themes|scripts|meta)$ ]] || { printf 'Invalid --only value.\n' >&2; exit 2; }
command -v git >/dev/null || { printf 'git is required.\n' >&2; exit 1; }
command -v php >/dev/null || { printf 'php is required to read the configuration.\n' >&2; exit 1; }
command -v rsync >/dev/null || { printf 'rsync is required.\n' >&2; exit 1; }
root="$(git rev-parse --show-toplevel)"
cd "$root"
[[ -f "$config" ]] || { printf 'Configuration not found: %s\n' "$config" >&2; exit 1; }

json() { php -r '$d=json_decode(file_get_contents($argv[1]),true,512,JSON_THROW_ON_ERROR); foreach(explode(".",$argv[2]) as $k){$d=$d[$k]??null;} if(is_scalar($d)) echo $d;' "$config" "$1"; }
organisation="${META_ORGANIZATION:-$(json organization)}"
meta_repository="${META_REPOSITORY:-$(json repository)}"
genre="${META_GENRE:-$(json genre)}"

if [[ "$mode" != "dry-run" ]]; then
    command -v gh >/dev/null || { printf 'gh is required for GitHub changes.\n' >&2; exit 1; }
    gh auth status --hostname github.com >/dev/null
fi
if [[ "$mode" == "push" && -n "$(git status --porcelain)" ]]; then
    printf 'Refusing to publish a dirty worktree. Commit intended changes first.\n' >&2
    exit 1
fi

ensure_repository() {
    local repository="$1" description="$2"
    gh repo view "$organisation/$repository" >/dev/null 2>&1 && return
    gh repo create "$organisation/$repository" "--$visibility" --description "$description" --disable-wiki
}

publish_path() {
    local path="$1" repository="$2"
    printf '%-48s <- %s\n' "$organisation/$repository" "$path"
    [[ "$mode" == "dry-run" ]] && return
    ensure_repository "$repository" "$genre package extracted from $meta_repository"
    [[ "$mode" == "create" ]] && return
    local staging
    staging="$(mktemp -d)/$repository"
    git clone --quiet --branch "$branch" "git@github.com:$organisation/$repository.git" "$staging"
    rsync -a --delete --exclude='.git' "$path/" "$staging/"
    git -C "$staging" add -A
    if ! git -C "$staging" diff --cached --quiet; then
        git -C "$staging" commit --quiet -m "Synchronize from $meta_repository"
        git -C "$staging" push origin "$branch"
    fi
}

for kind in modules themes scripts; do
    [[ "$only" == "all" || "$only" == "$kind" ]] || continue
    path="$(json "components.$kind.path")"
    [[ -d "$path" ]] || continue
    fixed_repository="$(json "components.$kind.repository")"
    prefix="$(json "components.$kind.repositoryPrefix")"
    if [[ -n "$fixed_repository" ]]; then
        publish_path "$path" "$fixed_repository"
    else
        while IFS= read -r component; do
            publish_path "$component" "$prefix$(basename "$component")"
        done < <(find "$path" -mindepth 1 -maxdepth 1 -type d -print | LC_ALL=C sort)
    fi
done

if [[ "$only" == "all" || "$only" == "meta" ]]; then
    printf '%-48s <- .\n' "$organisation/$meta_repository"
    if [[ "$mode" != "dry-run" ]]; then
        ensure_repository "$meta_repository" "$genre meta repository"
        [[ "$mode" == "push" ]] && git push "git@github.com:$organisation/$meta_repository.git" "HEAD:$branch"
    fi
fi
